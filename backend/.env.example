# Endroll API — Environment Variables
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase DB (from Supabase dashboard → Project Settings → Database)
DATABASE_URL="postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"

# Supabase API
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_KEY="sb_secret_[YOUR_SERVICE_KEY]"
SUPABASE_PAT="sbp_[YOUR_PERSONAL_ACCESS_TOKEN]"

# TMDB API (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=""

# Server
PORT=3001
